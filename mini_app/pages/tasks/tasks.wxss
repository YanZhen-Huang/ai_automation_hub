.filters {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.filter {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #888;
  font-size: 26rpx;
  transition: all 0.2s;
}

.filter-on {
  background: #4a6cf7;
  color: #fff;
}

.task:active {
  transform: scale(0.99);
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
}

.task-overdue {
  color: #e74c3c;
}

.task-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.task-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.task-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 12rpx 0;
}
