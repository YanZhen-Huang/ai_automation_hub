.input-card {
  padding: 20rpx;
  background: linear-gradient(180deg, #ffffff, #f6f8ff);
}

.input {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  background: #f8f9fb;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  transition: all 0.2s;
}

.input:focus {
  background: #fff;
  box-shadow: 0 0 0 2rpx #4a6cf7;
}

.input-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.input-btn {
  flex: 1;
}

.item-content {
  font-size: 28rpx;
  line-height: 1.5;
}

.item-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #aaa;
}
