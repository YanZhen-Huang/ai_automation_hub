<view class="page">

  <view class="card input-card anim-fade">
    <textarea class="input" placeholder="粘贴或输入一条信息，AI 会提炼要点和待办…" value="{{text}}" bindinput="onInput" maxlength="2000"></textarea>
    <view class="input-actions">
      <button class="btn btn-plain input-btn" hover-class="btn-hover" bindtap="scan">扫一扫</button>
      <button class="btn input-btn" hover-class="btn-hover" disabled="{{submitting}}" bindtap="submit">{{submitting ? '提交中…' : '提交'}}</button>
    </view>
  </view>

  <view class="section-title anim-fade">最近信息库</view>
  <view wx:if="{{items.length === 0}}" class="empty">暂无信息</view>
  <view wx:for="{{items}}" wx:key="id" class="card item anim-card" style="animation-delay: {{index * 50}}ms">
    <view class="item-content">{{item.content}}</view>
    <view class="item-meta">{{item.source}} · {{item.created_at}}</view>
  </view>

</view>
